@using Fanex.NAP.Client.Configuration
@using ParlayRMS.Site.ViewComponents
@inject IHttpContextAccessor contextAccessor
@inject INapSettings napSettings
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title</title>
    <link href="/favicon.ico" rel="shortcut icon" type="image/x-icon">
    <link rel="stylesheet" href="/Content/jquery-ui.css" type="text/css" />
    <link rel="stylesheet" href="/Content/lib.css" type="text/css" />
    <link rel="stylesheet" href="/Content.css" type="text/css" />
    <script type="text/ecmascript" src="/Scripts/lib.js"></script>
    <script type="text/ecmascript" src="/Scripts/core.js"></script>
    @if (napSettings.EnableReCheckIn)
    {
        <script src="/auth/recheckin.js" type="text/javascript"></script>
    }
    @await RenderSectionAsync("Head", false)
</head>
<body>
    <div id="mainPage">
        <div class="top-bar">
            @await Component.InvokeAsync(typeof(MenuViewComponent))
        </div>
        @if (ViewBag.HeaderText != null)
        {
            <div class="header showcase">
                <div class="content posrel">
                    <h1>@ViewBag.HeaderText</h1>
                </div>
            </div>
        }
        <div class="body showcase">
            <div class="content">
                <div class="clear-fix">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    <div id="loading" class="loading">
        <img alt="" src="@Url.Content("~/Content/images/Content/loading12.gif")" />
    </div>
    <div id="popup" class="invisible">
    </div>
    <div id="dialog-message">
    </div>
    @await Html.PartialAsync("_ConfirmBox", "Shared")
    @await Html.PartialAsync("_UpdateLevel", "Shared")
    @await RenderSectionAsync("Foot", false)
    @await RenderSectionAsync("Script", false)
    @if (!Context.User.Identity.Name.Contains("starix") && configuration.GetSection("Fanex.NAP.Client:Environment").Value == "LIVE")
    {
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-99SGH1CHFG"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){
                dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', 'G-99SGH1CHFG');
            gtag('username', '@Context.User.Identity.Name');
        </script>
    }
</body>
</html>