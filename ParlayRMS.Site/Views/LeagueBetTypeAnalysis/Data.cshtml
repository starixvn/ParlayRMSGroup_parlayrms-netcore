@model IEnumerable<ParlayRMS.Legacy.DTO.LeagueBetTypeAnalysis.RMS_Rpt_LeagueBettype_Analysis>
@{
    var filterOption = (Legacy.ViewModel.Report.LeagueBetTypeAnalysisOptions)ViewBag.FilterOption;
    var totalRows = Convert.ToInt32(ViewBag.TotalRows);
    var view = filterOption.ReportBy switch
    {
        1 => filterOption.IsDetail ? "_LeagueDetailData" : "_LeagueData",
        2 => filterOption.IsDetail ? "_BetTypeDetailData" : "_BetTypeData",
        _ => "_LeagueData"
    };
    var width = filterOption.ReportBy switch
    {
        1 => filterOption.IsDetail ? "1460px" : "1290px",
        2 => filterOption.IsDetail ? "1390px" : "1190px",
        _ => "1290px"
    };
}
@if (totalRows > 0)
{
    <div style="width: @width" class="maintitle">
        <div class="information">
            @ViewBag.Title
        </div>
        <div class="excel" onclick="LeagueBetTypeAnalysis.ExportExcel('@filterOption.Combo', '@filterOption.UserName', '@filterOption.ParlayType', '@filterOption.FromDate', '@filterOption.ToDate', '@filterOption.Leagues',  '@filterOption.LeagueGroups','@filterOption.Site', '@filterOption.Ratio', '@filterOption.ReportBy', '@filterOption.SportType', '@filterOption.BetType', '@filterOption.HouseWL', '@filterOption.IsDetail', '@filterOption.LeagueTitle', '@filterOption.BetTypeTitle')" title="Export Excel">
        </div>
    </div>
}
@await Html.PartialAsync(view, Model)
<br />
@{
    var username = @filterOption.UserName;
    var customerClass = Model.Select(m => m.CustomerClass).FirstOrDefault();
}

<script type="text/ecmascript">
    updateCachedCustomerClass('@username', '@customerClass' );
</script>
<input type="hidden" class="customer-class" value="@Model.Select(m=>m.CustomerClass).FirstOrDefault()" />
@if (totalRows > 100)
{
    <div style="width: @width">
        @await Html.PartialAsync("_Pager", (object)ViewBag.Pager)
    </div>
}
