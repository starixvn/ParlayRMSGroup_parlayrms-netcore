@{
    ViewBag.Title = ViewBag.HeaderText = ViewLang.PotentialWinningMonitor;
}
<link rel="stylesheet" href="/Content/PotentialWinning.css" type="text/css" />

@await Component.InvokeAsync("PotentialWinningFilter")
<div id="noflash" style="display: none">
    Adobe Flash Player or an HTML5 supported browser is required for this feature
    <br />
    Use one of the following ways to get it back:
    <br />
    <ul>
        <li>
            <a href="http://get.adobe.com/flashplayer" target="_blank">
                Download the latest Flash
                Player
            </a>
        </li>
        <li>
            <a href="https://www.youtube.com/html5" target="_blank">
                Upgrade to an HTML5 supported
                browser
            </a>
        </li>
    </ul>
</div>
<div style="clear: both; display: none" id="divResult">
    <div id="divBreadcrumb" style="margin-bottom: 10px;"></div>
    @Html.Partial("_MemberData")
    @Html.Partial("_AgentData")
</div>
<script type="text/ecmascript" src="/Scripts/Libs/multiselect/jquery-ui-multiselect-widget-3.0.0/jquery.multiselect.filter.js"></script>
<script type="text/ecmascript" src="/Scripts/Monitor/PotentialWinning.js"></script>
<script type="text/ecmascript" src="/Scripts/Member/Core.js"></script>

<script type="text/javascript">
    var _resource = {
        'allSports': '@ViewLang.Allsports',
        'soccerOnly': '@ViewLang.Socceronly',
        'combinedSports': '@ViewLang.Combinedsports',
        'otherSports': '@ViewLang.Othersports'
    };
</script>
