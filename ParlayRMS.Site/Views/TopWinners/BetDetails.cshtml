@model ParlayRMS.Legacy.ViewModel.Report.BetDetails
@{
    Layout = null;
    ViewBag.Title = ViewBag.HeaderText = ViewLang.TicketDetails;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta content="text/html" charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link rel="stylesheet" type="text/css" href="http://fonts.googleapis.com/css?family=Abel" />
    <link rel="stylesheet" href="/Content/jquery-ui.css" type="text/css" />
    <link rel="stylesheet" href="/Content/lib.css" type="text/css" />
    <link rel="stylesheet" href="/Content.css" type="text/css" />
    <meta name="viewport" content="width=device-width" />
</head>
<body>
    <div style="text-align: left; margin-left: auto; margin-right: auto; overflow: hidden">
        <div style="float: left; left: 50%; position: relative">
            <div class="boxMain" style="float: left; position: relative; right: 50%;">
                <div class="content">
                    <table class="bet-detail">
                        <tr class="title2">
                            <th>
                                Ticket Details - @ViewBag.Username - @ViewBag.BetId
                            </th>
                            <th class="combo-type">
                                @ViewLang.ComboType
                            </th>
                        </tr>
                        <tr>
                            <td>
                                <div class="betdetails">
                                    @Html.Raw(Model.TicketDetail)
                                </div>
                            </td>
                            <td class="combo-type">
                                @if (Model.ComboTypes != null)
                                {
                                    @Html.Raw(string.Join("<br />", Model.ComboTypes))
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>