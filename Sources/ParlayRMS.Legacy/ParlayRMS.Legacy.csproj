<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
	<PropertyGroup>
		<!-- Exclude the project from analysis -->
		<SonarQubeExclude>True</SonarQubeExclude>
	</PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;8632</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fanex.BetList.Core" Version="3.0.4.4" />
    <PackageReference Include="Fanex.BetList.Core.RemotingRef" Version="2.0.0.2" />
    <PackageReference Include="Fanex.Caching.AspNetCore" Version="2.2.5" />
    <PackageReference Include="Fanex.Data.ProxyClient" Version="1.0.3" />
    <PackageReference Include="Fanex.NAP.Client" Version="2.0.2" />
    <PackageReference Include="Fanex.RemotingRef" Version="1.5.5.1" />
    <PackageReference Include="Fizzler" Version="1.3.1" />
    <PackageReference Include="Fizzler.Systems.HtmlAgilityPack" Version="1.2.1" />
    <PackageReference Include="NPOI" Version="2.7.2" />
    <PackageReference Include="X.PagedList" Version="10.5.7" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="ViewLang.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ViewLang.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="ViewLang.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ViewLang.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
